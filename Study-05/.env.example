# 작성일시: 2026-10-27 15:35
# 이 파일을 .env로 복사하고 값을 채운다. .env는 git에 올리지 않는다.
OPENROUTER_API_KEY=your-openrouter-api-key

# 선택: 기본 모델과 대체 모델(쉼표 구분, 순서대로 전환). 비우면 src/config.js의 기본값
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free

# 선택: 서버 주소 (기본 127.0.0.1:3000). 요청의 Host·Origin은 127.0.0.1·localhost·HOST 값 + PORT만 허용
# PORT를 바꾸면 index.html을 file://로 열었을 때의 자동 이동(3000 고정)이 맞지 않으니 http://127.0.0.1:<PORT>/ 를 직접 연다
# PORT=3000
# HOST=127.0.0.1

# 선택: AI 호출 상한 (일기 1건당 호출 수·전체 시간, 호출 1회 타임아웃, 최대 출력 토큰)
# AI_MAX_CALLS=4
# AI_TOTAL_TIMEOUT_MS=60000
# AI_CALL_TIMEOUT_MS=20000
# AI_MAX_TOKENS=1000

# 선택: 추론 노력(reasoning.effort). 기본 none(추론 토큰이 답을 자르지 않게). 추론이 필수인 모델이면 비운다
# AI_REASONING_EFFORT=none
