# 작성일시: 2026-10-27 15:35
# 이 파일을 .env로 복사하고 값을 채운다. .env는 git에 올리지 않는다.
OPENROUTER_API_KEY=your-openrouter-api-key

# 선택: 기본 모델과 대체 모델(쉼표 구분, 순서대로 전환). 비우면 src/config.js의 기본값
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free

# 선택: 서버 주소 (기본 127.0.0.1:3000). 요청의 Host·Origin은 127.0.0.1·localhost·HOST 값 + PORT만 허용
# PORT를 바꾸면 index.html을 file://로 열었을 때의 자동 이동(3000 고정)이 맞지 않으니 http://127.0.0.1:<PORT>/ 를 직접 연다
# PORT=3000
# HOST=127.0.0.1

# 선택: AI 호출 상한 (일기 1건당 호출 수·전체 시간, 호출 1회 타임아웃, 최대 출력 토큰)
# AI_MAX_CALLS=4
# AI_TOTAL_TIMEOUT_MS=60000
# AI_CALL_TIMEOUT_MS=20000
# AI_MAX_TOKENS=1000

# 선택: 추론 노력(reasoning.effort). 기본 none(추론 토큰이 답을 자르지 않게). 추론이 필수인 모델이면 비운다
# AI_REASONING_EFFORT=none

# 선택: PDF 요약 (POST /api/pdf/summarize, 화면 http://127.0.0.1:3000/pdf). 비우면 src/config.js의 기본값
# rerank 모델(긴 문서의 핵심 조각 고르기). PDF_RERANK_MODEL= 로 비우면 rerank 없이 앞·뒷부분으로 요약
# PDF_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
# 업로드 상한(바이트, 기본 20MB)·읽을 최대 페이지·사용할 추출 텍스트 상한(코드 포인트)
# PDF_MAX_BYTES=20971520
# PDF_MAX_PAGES=200
# PDF_MAX_TEXT_CHARS=200000
# 요약 모델에 넣을 텍스트 상한. 이 이하면 rerank 없이 전체 요약
# PDF_CONTEXT_CHARS=20000
# 문서 1건당 호출 수(rerank 포함)·전체 시간(화면 120초보다 작게)·채팅 1회·rerank 1회·텍스트 추출 시간·요약 max_tokens
# PDF_AI_MAX_CALLS=4
# PDF_TOTAL_TIMEOUT_MS=90000
# PDF_CALL_TIMEOUT_MS=35000
# PDF_RERANK_TIMEOUT_MS=15000
# PDF_EXTRACT_TIMEOUT_MS=15000
# 추출 워커 V8 힙 상한(MB)·추출 중 RSS 증가 상한(MB, 압축을 푼 버퍼 포함. 넘으면 둘 다 PDF_TOO_COMPLEX, 0이면 RSS 감시 끔)
# 쪽당 텍스트 항목 수 상한(넘는 부분은 읽지 않음)
# PDF_WORKER_MEMORY_MB=512
# PDF_EXTRACT_MAX_RSS_MB=1024
# PDF_MAX_ITEMS_PER_PAGE=50000
# PDF_SUMMARY_MAX_TOKENS=3000
# rerank 1회에 보낼 조각 수 상한(넘으면 조각을 크게 합쳐 맞춤)
# PDF_RERANK_MAX_DOCUMENTS=128
