# 작성일시: 2026-10-26 14:10
# 이 파일을 .env로 복사한 뒤 실제 키를 넣으세요. (.env는 git에 올라가지 않습니다)
# 키 발급: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# (선택) 모델 순서 변경. 쉼표로 구분하고 앞에서부터 시도하며, 모델 쪽 장애 시 다음 모델로 넘어갑니다.
# 비워 두면 src/config.js의 기본 무료 모델 목록을 씁니다.
# EMBED_MODELS=nvidia/nemotron-3.5-embed-1b:free,nvidia/llama-nemotron-embed-vl-1b-v2:free
# CHAT_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-31b-it:free

# (선택) 서버 포트. 기본 3000
# PORT=3000

# (선택) 서버가 접속을 받을 주소. 기본 127.0.0.1(이 컴퓨터에서만 접속 가능).
# 같은 네트워크의 휴대폰 등에서 접속하려면 0.0.0.0 (다른 사람도 이 서버로 AI 한도를 쓸 수 있으니 주의)
# HOST=127.0.0.1

# (선택) 재료 인식 판정 기준. 기본값은 src/config.js 참고 (숫자가 아니면 서버가 시작되지 않습니다)
# RECOGNITION_THRESHOLD=0.3
# RECOGNITION_TOP_K=5

# (선택) 사용자 요청 1건(재료 인식 1회, 레시피 추천 1회)이 쓸 수 있는 AI 호출 수와 전체 시간(ms).
# 재시도·대체 모델을 모두 합친 상한이며, 넘으면 BUDGET_EXCEEDED 오류로 중단합니다.
# REQUEST_MAX_CALLS=6
# REQUEST_TIME_BUDGET_MS=90000
